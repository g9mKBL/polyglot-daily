{
  "name": "polyglot-daily",
  "version": "1.0.0",
  "description": "Multilingual learning platform for English (CEFR A1-C2), Mandarin Chinese (HSK 1-6), and Japanese (JLPT N5-N1) with user accounts, SRS, study groups, and leaderboards.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/db/seed.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:e2e": "node \"tests/e2e/app.spec.mjs\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.52.0"
  }
}
